{
  // SERVER FRAGMENTS ONLY — do not copy this object as a complete opencode.json.
  // Prefer the official initializer for shadcn:
  //   npx shadcn@latest mcp init --client opencode
  // OpenCode MCP container/enabled-field shape can differ by installed version;
  // merge the server entry into the schema used by the current OpenCode config.

  "shadcn": {
    "type": "local",
    "command": ["npx", "-y", "shadcn@latest", "mcp"]
  },

  // Optional Jpisnice secondary/reference MCP. Keep the token in local
  // environment/secret state and never commit its literal value.
  "shadcn_public": {
    "type": "local",
    "command": [
      "sh",
      "-lc",
      "test -n \"$GITHUB_PERSONAL_ACCESS_TOKEN\" || { echo \"GITHUB_PERSONAL_ACCESS_TOKEN is required for shadcn_public MCP\" >&2; exit 1; }; npx -y @jpisnice/shadcn-ui-mcp-server --github-api-key \"$GITHUB_PERSONAL_ACCESS_TOKEN\""
    ]
  }
}
